<Window x:Class="RPGEditor.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:RPGEditor"
        xmlns:vm="clr-namespace:RPGEditor.ViewModels"
        mc:Ignorable="d"
        x:Name="RootWindow"
        Title="RPG Editor" Height="720" Width="1200">
    <Window.DataContext>
        <vm:MainViewModel />
    </Window.DataContext>
    <Window.InputBindings>
        <KeyBinding Key="N" Modifiers="Control"
                    Command="{Binding DataContext.NewProjectCommand, ElementName=RootWindow}"
                    CommandParameter="{Binding ElementName=RootWindow}" />
        <KeyBinding Key="O" Modifiers="Control"
                    Command="{Binding DataContext.OpenProjectCommand, ElementName=RootWindow}"
                    CommandParameter="{Binding ElementName=RootWindow}" />
        <KeyBinding Key="S" Modifiers="Control"
                    Command="{Binding DataContext.SaveProjectCommand, ElementName=RootWindow}" />
    </Window.InputBindings>
    <DockPanel>
        <Menu DockPanel.Dock="Top">
            <MenuItem Header="파일(_F)">
                <MenuItem Header="새 프로젝트(_N)..." InputGestureText="Ctrl+N"
                          Command="{Binding NewProjectCommand}"
                          CommandParameter="{Binding RelativeSource={RelativeSource AncestorType=Window}}" />
                <MenuItem Header="프로젝트 열기(_O)..." InputGestureText="Ctrl+O"
                          Command="{Binding OpenProjectCommand}"
                          CommandParameter="{Binding RelativeSource={RelativeSource AncestorType=Window}}" />
                <MenuItem Header="저장(_S)" InputGestureText="Ctrl+S"
                          Command="{Binding SaveProjectCommand}" />
                <Separator />
                <MenuItem Header="종료(_X)" Command="{Binding ExitCommand}" />
            </MenuItem>
        </Menu>

        <StatusBar DockPanel.Dock="Bottom">
            <StatusBarItem>
                <TextBlock Text="{Binding StatusText}" />
            </StatusBarItem>
        </StatusBar>

        <Grid>
            <TabControl ItemsSource="{Binding Tabs}"
                        TabStripPlacement="Left"
                        Visibility="{Binding HasProject, Converter={StaticResource BoolToVisibilityConverter}}">
                <TabControl.ItemTemplate>
                    <DataTemplate DataType="{x:Type vm:EditorTab}">
                        <TextBlock Text="{Binding Header}" Padding="6,4" />
                    </DataTemplate>
                </TabControl.ItemTemplate>
                <TabControl.ContentTemplate>
                    <DataTemplate DataType="{x:Type vm:EditorTab}">
                        <ContentPresenter Content="{Binding Content}" />
                    </DataTemplate>
                </TabControl.ContentTemplate>
            </TabControl>

            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center"
                        Visibility="{Binding HasProject, Converter={StaticResource BoolToVisibilityConverter}, ConverterParameter=Invert}">
                <TextBlock Text="열려 있는 프로젝트가 없습니다." FontSize="16" HorizontalAlignment="Center" Margin="0,0,0,12" />
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                    <Button Content="새 프로젝트..." Padding="12,6"
                            Command="{Binding NewProjectCommand}"
                            CommandParameter="{Binding RelativeSource={RelativeSource AncestorType=Window}}" />
                    <Button Content="프로젝트 열기..." Padding="12,6" Margin="8,0,0,0"
                            Command="{Binding OpenProjectCommand}"
                            CommandParameter="{Binding RelativeSource={RelativeSource AncestorType=Window}}" />
                </StackPanel>
            </StackPanel>
        </Grid>
    </DockPanel>
</Window>
