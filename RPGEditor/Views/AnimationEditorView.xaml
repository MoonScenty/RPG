<UserControl x:Class="RPGEditor.Views.AnimationEditorView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:views="clr-namespace:RPGEditor.Views"
             mc:Ignorable="d"
             d:DesignHeight="800" d:DesignWidth="900">
    <Grid Margin="8">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="240" />
            <ColumnDefinition Width="8" />
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="8" />
            <ColumnDefinition Width="320" />
        </Grid.ColumnDefinitions>

        <views:EntryListPanel Grid.Column="0" ShowId="True" />

        <GridSplitter Grid.Column="1" Width="8" HorizontalAlignment="Stretch" Background="Transparent" />

        <!-- 이 데이터는 RPG Maker MV 에디터에서만 편집되고 여기선 참고/미리보기+선택
             용도로만 읽으므로(원본 프레임/타이밍 데이터를 그대로 보존해야 함), 아래는
             전부 읽기 전용 표시다 - 편집 가능한 TextBox/DataGrid를 두지 않는다. -->
        <ScrollViewer Grid.Column="2" VerticalScrollBarVisibility="Auto"
                      IsEnabled="{Binding Selected, Converter={StaticResource NullToBooleanConverter}}">
            <StackPanel Margin="0,0,10,0">
                <TextBlock Text="이름" Margin="0,0,0,4" />
                <TextBlock Text="{Binding Selected.Name}" FontWeight="Bold" Margin="0,0,0,10" />

                <Grid Margin="0,0,0,10">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="8" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="0">
                        <TextBlock Text="이미지 1 (색조)" Margin="0,0,0,4" />
                        <TextBlock>
                            <Run Text="{Binding Selected.Animation1Name, Mode=OneWay}" />
                            <Run Text=" (" /><Run Text="{Binding Selected.Animation1Hue, Mode=OneWay}" /><Run Text=")" />
                        </TextBlock>
                    </StackPanel>
                    <StackPanel Grid.Column="2">
                        <TextBlock Text="이미지 2 (색조)" Margin="0,0,0,4" />
                        <TextBlock>
                            <Run Text="{Binding Selected.Animation2Name, Mode=OneWay}" />
                            <Run Text=" (" /><Run Text="{Binding Selected.Animation2Hue, Mode=OneWay}" /><Run Text=")" />
                        </TextBlock>
                    </StackPanel>
                </Grid>

                <TextBlock Text="표시 위치 (0=머리 1=중앙 2=발밑 3=화면 고정)" Margin="0,0,0,4" />
                <TextBlock Text="{Binding Selected.Position}" Margin="0,0,0,10" />

                <TextBlock Text="프레임 수" Margin="0,0,0,4" />
                <TextBlock Text="{Binding Selected.Frames.Count}" Margin="0,0,0,10" />

                <TextBlock Text="SE/플래시 타이밍" FontWeight="Bold" Margin="0,0,0,6" />
                <ItemsControl ItemsSource="{Binding Selected.Timings}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <TextBlock Margin="0,0,0,2">
                                <Run Text="프레임 " /><Run Text="{Binding Frame, Mode=OneWay}" />
                                <Run Text=" - SE: " /><Run Text="{Binding Se.Name, Mode=OneWay}" />
                                <Run Text=" / 플래시scope: " /><Run Text="{Binding FlashScope, Mode=OneWay}" />
                            </TextBlock>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>

                <TextBlock Text="(프레임 셀 배치/타이밍 편집은 RPG Maker MV 에디터에서 - 여기서는 참고 및 재생만)"
                           Foreground="Gray" TextWrapping="Wrap" Margin="0,14,0,0" />
            </StackPanel>
        </ScrollViewer>

        <GridSplitter Grid.Column="3" Width="8" HorizontalAlignment="Stretch" Background="Transparent" />

        <DockPanel Grid.Column="4">
            <TextBlock DockPanel.Dock="Top" Text="미리보기" FontWeight="Bold" Margin="0,0,0,6" />
            <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" Margin="0,6,0,0">
                <Button Content="▶ 재생" Width="90" Click="PlayButton_Click"
                        IsEnabled="{Binding Selected, Converter={StaticResource NullToBooleanConverter}}" />
                <Button Content="■ 정지" Width="90" Margin="6,0,0,0" Click="StopButton_Click" />
            </StackPanel>
            <views:AnimationPreviewControl x:Name="Preview" Height="260" />
        </DockPanel>
    </Grid>
</UserControl>
