<UserControl x:Class="RPGEditor.Views.EntryListPanel"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             mc:Ignorable="d"
             d:DesignHeight="450" d:DesignWidth="240">
    <DockPanel>
        <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" Margin="0,6,0,0">
            <Button Content="추가" Width="56" Command="{Binding AddCommand}" />
            <Button Content="복제" Width="56" Margin="4,0,0,0" Command="{Binding DuplicateCommand}" />
            <Button Content="삭제" Width="56" Margin="4,0,0,0" Command="{Binding DeleteCommand}" />
            <Button Content="↑" Width="28" Margin="4,0,0,0" Command="{Binding MoveUpCommand}" />
            <Button Content="↓" Width="28" Margin="4,0,0,0" Command="{Binding MoveDownCommand}" />
        </StackPanel>
        <ListBox ItemsSource="{Binding Entries}"
                 SelectedItem="{Binding Selected}">
            <ListBox.ItemTemplate>
                <DataTemplate>
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="{Binding Id}" Width="34" Margin="0,0,4,0" Foreground="Gray"
                                   Visibility="{Binding ShowId, RelativeSource={RelativeSource AncestorType=UserControl}, Converter={StaticResource BoolToVisibilityConverter}}" />
                        <TextBlock Text="{Binding Name}" />
                    </StackPanel>
                </DataTemplate>
            </ListBox.ItemTemplate>
        </ListBox>
    </DockPanel>
</UserControl>
