<UserControl x:Class="RPGEditor.Views.StateEditorView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:views="clr-namespace:RPGEditor.Views"
             mc:Ignorable="d"
             d:DesignHeight="800" d:DesignWidth="1000">
    <Grid Margin="8">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="240" />
            <ColumnDefinition Width="8" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <views:EntryListPanel Grid.Column="0" ShowId="True" />

        <GridSplitter Grid.Column="1" Width="8" HorizontalAlignment="Stretch" Background="Transparent" />

        <ScrollViewer Grid.Column="2" VerticalScrollBarVisibility="Auto"
                      IsEnabled="{Binding Selected, Converter={StaticResource NullToBooleanConverter}}">
            <StackPanel Margin="0,0,10,0">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="16" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Column="0">
                        <Grid Margin="0,0,0,10">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="8" />
                                <ColumnDefinition Width="130" />
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0">
                                <TextBlock Text="이름" Margin="0,0,0,4" />
                                <TextBox Text="{Binding Selected.Name, UpdateSourceTrigger=PropertyChanged}" />
                            </StackPanel>
                            <StackPanel Grid.Column="2">
                                <TextBlock Text="아이콘" Margin="0,0,0,4" />
                                <views:IconField x:Name="IconField" IconIndex="{Binding Selected.IconIndex, UpdateSourceTrigger=PropertyChanged}" />
                            </StackPanel>
                        </Grid>

                        <Grid Margin="0,0,0,10">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="8" />
                                <ColumnDefinition Width="90" />
                                <ColumnDefinition Width="8" />
                                <ColumnDefinition Width="90" />
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0">
                                <TextBlock Text="SV 모션" Margin="0,0,0,4" />
                                <ComboBox IsEditable="True"
                                          ItemsSource="{Binding Source={StaticResource SvMotionValues}}"
                                          Text="{Binding Selected.Motion, UpdateSourceTrigger=PropertyChanged}" />
                            </StackPanel>
                            <StackPanel Grid.Column="2">
                                <TextBlock Text="우선순위" Margin="0,0,0,4" />
                                <TextBox Text="{Binding Selected.Priority, UpdateSourceTrigger=PropertyChanged}" />
                            </StackPanel>
                            <StackPanel Grid.Column="4">
                                <TextBlock Text="오버레이" Margin="0,0,0,4" />
                                <TextBox Text="{Binding Selected.Overlay, UpdateSourceTrigger=PropertyChanged}" />
                            </StackPanel>
                        </Grid>

                        <TextBlock Text="행동 제한" Margin="0,0,0,4" />
                        <ComboBox ItemsSource="{Binding Source={StaticResource StateRestrictionValues}}"
                                  SelectedItem="{Binding Selected.Restriction}"
                                  ItemTemplate="{StaticResource EnumDisplayItemTemplate}" Margin="0,0,0,10" />

                        <Border BorderBrush="Gray" BorderThickness="0,1,0,0" Padding="0,10,0,0">
                            <StackPanel>
                                <TextBlock Text="해제 조건" FontWeight="Bold" Margin="0,0,0,6" />
                                <CheckBox Content="전투 종료 시 해제" IsChecked="{Binding Selected.RemoveAtBattleEnd}" Margin="0,0,0,6" />
                                <CheckBox Content="행동 제한에 따라 해제" IsChecked="{Binding Selected.RemoveByRestriction}" Margin="0,0,0,6" />

                                <TextBlock Text="자동 해제 타이밍" Margin="0,0,0,4" />
                                <ComboBox ItemsSource="{Binding Source={StaticResource StateAutoRemovalTimingValues}}"
                                          SelectedItem="{Binding Selected.AutoRemovalTiming}"
                                          ItemTemplate="{StaticResource EnumDisplayItemTemplate}" Margin="0,0,0,6" />

                                <TextBlock Text="지속 순번 횟수 (최소~최대)" Margin="0,0,0,4" />
                                <Grid Margin="0,0,0,6">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="80" />
                                        <ColumnDefinition Width="8" />
                                        <ColumnDefinition Width="8" />
                                        <ColumnDefinition Width="8" />
                                        <ColumnDefinition Width="80" />
                                    </Grid.ColumnDefinitions>
                                    <TextBox Grid.Column="0" Text="{Binding Selected.MinTurns, UpdateSourceTrigger=PropertyChanged}" />
                                    <TextBlock Grid.Column="2" Text="~" HorizontalAlignment="Center" />
                                    <TextBox Grid.Column="4" Text="{Binding Selected.MaxTurns, UpdateSourceTrigger=PropertyChanged}" />
                                </Grid>

                                <CheckBox Content="피해로 인한 해제" IsChecked="{Binding Selected.RemoveByDamage}" Margin="0,0,0,6" />
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="8" />
                                        <ColumnDefinition Width="100" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Grid.Column="0" />
                                    <StackPanel Grid.Column="2">
                                        <TextBlock Text="해제 확률(%)" Margin="0,0,0,4" />
                                        <TextBox Text="{Binding Selected.RemoveByDamageChance, UpdateSourceTrigger=PropertyChanged}" />
                                    </StackPanel>
                                </Grid>
                            </StackPanel>
                        </Border>

                        <Border BorderBrush="Gray" BorderThickness="0,1,0,0" Margin="0,10,0,0" Padding="0,10,0,0">
                            <StackPanel>
                                <TextBlock Text="전투 효과 (비우면 없음)" FontWeight="Bold" Margin="0,0,0,6" />
                                <Grid Margin="0,0,0,6">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="6" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Grid.Column="0">
                                        <TextBlock Text="매 턴 도트 피해(최대HP %)" Margin="0,0,0,4" />
                                        <TextBox Text="{Binding Selected.DotPercent, UpdateSourceTrigger=PropertyChanged, TargetNullValue=''}" />
                                    </StackPanel>
                                    <StackPanel Grid.Column="2">
                                        <TextBlock Text="매 턴 지속 회복(최대HP %)" Margin="0,0,0,4" />
                                        <TextBox Text="{Binding Selected.HotPercent, UpdateSourceTrigger=PropertyChanged, TargetNullValue=''}" />
                                    </StackPanel>
                                </Grid>
                                <Grid Margin="0,0,0,6">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="6" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Grid.Column="0">
                                        <TextBlock Text="받는 피해율(%, 100=변화 없음)" Margin="0,0,0,4" />
                                        <TextBox Text="{Binding Selected.DamageTakenRate, UpdateSourceTrigger=PropertyChanged, TargetNullValue=''}" />
                                    </StackPanel>
                                    <StackPanel Grid.Column="2">
                                        <TextBlock Text="보호막(최대HP %, 1회 흡수 후 소멸)" Margin="0,0,0,4" />
                                        <TextBox Text="{Binding Selected.ShieldAbsorbPercent, UpdateSourceTrigger=PropertyChanged, TargetNullValue=''}" />
                                    </StackPanel>
                                </Grid>
                                <Grid Margin="0,0,0,6">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="6" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Grid.Column="0">
                                        <TextBlock Text="캐스팅 소요 턴 단축(%, 영창 가속)" Margin="0,0,0,4" />
                                        <TextBox Text="{Binding Selected.CastSpeedRatePercent, UpdateSourceTrigger=PropertyChanged, TargetNullValue=''}" />
                                    </StackPanel>
                                    <StackPanel Grid.Column="2">
                                        <TextBlock Text="흡혈률 가산(%p, 스킬 자체 흡혈률에 더함)" Margin="0,0,0,4" />
                                        <TextBox Text="{Binding Selected.LifestealBonusPercent, UpdateSourceTrigger=PropertyChanged, TargetNullValue=''}" />
                                    </StackPanel>
                                </Grid>
                                <WrapPanel>
                                    <CheckBox Content="도발(적 AI가 우선 타겟팅)" IsChecked="{Binding Selected.Taunt}" Margin="0,0,16,0" />
                                    <CheckBox Content="감싸기(아군 대신 피해를 받음)" IsChecked="{Binding Selected.GuardAlly}" Margin="0,0,16,0" />
                                    <CheckBox Content="빈사 방지(HP 1 밑으로 안 떨어짐)" IsChecked="{Binding Selected.Undying}" Margin="0,0,16,0" />
                                    <CheckBox Content="디버프(부정적 효과 - 디버프 해제 스킬의 대상)" IsChecked="{Binding Selected.IsDebuff}" />
                                </WrapPanel>
                            </StackPanel>
                        </Border>
                    </StackPanel>

                    <StackPanel Grid.Column="2">
                        <Border BorderBrush="Gray" BorderThickness="0,0,0,0" Padding="0,0,0,0">
                            <StackPanel>
                                <TextBlock Text="메시지 (%1=대상, %2=시전자)" FontWeight="Bold" Margin="0,0,0,6" />

                                <TextBlock Text="해당 상태가 됐을 때" Margin="0,0,0,4" />
                                <TextBox Text="{Binding Selected.MessageWhenAdded, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,0,6" />

                                <TextBlock Text="적 캐릭터가 해당 상태가 됐을 때" Margin="0,0,0,4" />
                                <TextBox Text="{Binding Selected.MessageWhenAddedEnemy, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,0,6" />

                                <TextBlock Text="해당 상태가 계속될 때" Margin="0,0,0,4" />
                                <TextBox Text="{Binding Selected.MessageWhileActive, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,0,6" />

                                <TextBlock Text="해당 상태가 해제될 때" Margin="0,0,0,4" />
                                <TextBox Text="{Binding Selected.MessageWhenRemoved, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,0,10" />
                            </StackPanel>
                        </Border>

                        <TextBlock Text="메모" Margin="0,0,0,4" />
                        <TextBox Text="{Binding Selected.Note, UpdateSourceTrigger=PropertyChanged}"
                                 AcceptsReturn="True" TextWrapping="Wrap" Height="100"
                                 VerticalScrollBarVisibility="Auto" />
                    </StackPanel>
                </Grid>
            </StackPanel>
        </ScrollViewer>
    </Grid>
</UserControl>
