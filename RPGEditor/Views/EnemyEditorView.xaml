<UserControl x:Class="RPGEditor.Views.EnemyEditorView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:views="clr-namespace:RPGEditor.Views"
             mc:Ignorable="d"
             d:DesignHeight="900" d:DesignWidth="900">
    <Grid Margin="8">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="240" />
            <ColumnDefinition Width="8" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <views:EntryListPanel Grid.Column="0" />

        <GridSplitter Grid.Column="1" Width="8" HorizontalAlignment="Stretch" Background="Transparent" />

        <ScrollViewer Grid.Column="2" VerticalScrollBarVisibility="Auto"
                      IsEnabled="{Binding Selected, Converter={StaticResource NullToBooleanConverter}}">
            <StackPanel MaxWidth="680" HorizontalAlignment="Left">
                <TextBlock Text="{Binding Selected.Id, StringFormat='ID: {0}'}" Margin="0,0,0,10" />

                <TextBlock Text="이름" Margin="0,0,0,4" />
                <TextBox Text="{Binding Selected.Name, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,0,10" />

                <Grid Margin="0,0,0,10">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="8" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="0">
                        <TextBlock Text="보상 경험치" Margin="0,0,0,4" />
                        <TextBox Text="{Binding Selected.RewardExp, UpdateSourceTrigger=PropertyChanged}" />
                    </StackPanel>
                    <StackPanel Grid.Column="2">
                        <TextBlock Text="보상 골드" Margin="0,0,0,4" />
                        <TextBox Text="{Binding Selected.RewardGold, UpdateSourceTrigger=PropertyChanged}" />
                    </StackPanel>
                </Grid>

                <TextBlock Text="스탯" FontWeight="Bold" Margin="0,0,0,6" />
                <WrapPanel Margin="0,0,0,10">
                    <StackPanel Margin="0,0,6,6">
                        <TextBlock Text="HP" HorizontalAlignment="Center" />
                        <TextBox Width="54" Text="{Binding Selected.Stats.Hp, UpdateSourceTrigger=PropertyChanged}" />
                    </StackPanel>
                    <StackPanel Margin="0,0,6,6">
                        <TextBlock Text="MP" HorizontalAlignment="Center" />
                        <TextBox Width="54" Text="{Binding Selected.Stats.Mp, UpdateSourceTrigger=PropertyChanged}" />
                    </StackPanel>
                    <StackPanel Margin="0,0,6,6">
                        <TextBlock Text="STR" HorizontalAlignment="Center" />
                        <TextBox Width="54" Text="{Binding Selected.Stats.Str, UpdateSourceTrigger=PropertyChanged}" />
                    </StackPanel>
                    <StackPanel Margin="0,0,6,6">
                        <TextBlock Text="VIT" HorizontalAlignment="Center" />
                        <TextBox Width="54" Text="{Binding Selected.Stats.Vit, UpdateSourceTrigger=PropertyChanged}" />
                    </StackPanel>
                    <StackPanel Margin="0,0,6,6">
                        <TextBlock Text="INT" HorizontalAlignment="Center" />
                        <TextBox Width="54" Text="{Binding Selected.Stats.Int, UpdateSourceTrigger=PropertyChanged}" />
                    </StackPanel>
                    <StackPanel Margin="0,0,6,6">
                        <TextBlock Text="MND" HorizontalAlignment="Center" />
                        <TextBox Width="54" Text="{Binding Selected.Stats.Mnd, UpdateSourceTrigger=PropertyChanged}" />
                    </StackPanel>
                    <StackPanel Margin="0,0,6,6">
                        <TextBlock Text="DEX" HorizontalAlignment="Center" />
                        <TextBox Width="54" Text="{Binding Selected.Stats.Dex, UpdateSourceTrigger=PropertyChanged}" />
                    </StackPanel>
                    <StackPanel Margin="0,0,6,6">
                        <TextBlock Text="AGI" HorizontalAlignment="Center" />
                        <TextBox Width="54" Text="{Binding Selected.Stats.Agi, UpdateSourceTrigger=PropertyChanged}" />
                    </StackPanel>
                    <StackPanel Margin="0,0,6,6">
                        <TextBlock Text="LUK" HorizontalAlignment="Center" />
                        <TextBox Width="54" Text="{Binding Selected.Stats.Luk, UpdateSourceTrigger=PropertyChanged}" />
                    </StackPanel>
                </WrapPanel>

                <TextBlock Text="드롭 아이템 (Items.json)" FontWeight="Bold" Margin="0,0,0,6" />
                <DataGrid ItemsSource="{Binding Selected.Drops}"
                          AutoGenerateColumns="False"
                          CanUserAddRows="True"
                          CanUserDeleteRows="True"
                          CanUserSortColumns="False"
                          Height="140"
                          Margin="0,0,0,10">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="아이템 ID" Binding="{Binding ItemId}" Width="100" />
                        <DataGridTextColumn Header="드롭 확률(%)" Binding="{Binding DropRate}" Width="100" />
                    </DataGrid.Columns>
                </DataGrid>

                <TextBlock Text="행동 패턴 (Skills.json)" FontWeight="Bold" Margin="0,0,0,6" />
                <DataGrid ItemsSource="{Binding Selected.Actions}"
                          AutoGenerateColumns="False"
                          CanUserAddRows="True"
                          CanUserDeleteRows="True"
                          CanUserSortColumns="False"
                          Height="160"
                          Margin="0,0,0,10">
                    <DataGrid.Columns>
                        <DataGridComboBoxColumn Header="조건"
                                                 ItemsSource="{Binding Source={StaticResource EnemyActionConditionTypeValues}}"
                                                 SelectedItemBinding="{Binding ConditionType}"
                                                 Width="120" />
                        <DataGridTextColumn Header="값1" Binding="{Binding Param1}" Width="60" />
                        <DataGridTextColumn Header="값2" Binding="{Binding Param2}" Width="60" />
                        <DataGridTextColumn Header="상태 ID" Binding="{Binding StateId}" Width="70" />
                        <DataGridTextColumn Header="우선도" Binding="{Binding Priority}" Width="60" />
                        <DataGridTextColumn Header="스킬 ID" Binding="{Binding SkillId}" Width="70" />
                    </DataGrid.Columns>
                </DataGrid>
                <TextBlock Text="값1/값2 의미: 순번=매 N턴/시작오프셋, HP·MP범위=최소%/최대%, 상태조건은 상태 ID만 사용"
                           FontStyle="Italic" Foreground="Gray" TextWrapping="Wrap" Margin="0,0,0,10" />

                <Grid Margin="0,0,0,10">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="8" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="0">
                        <TextBlock Text="이미지 유형" Margin="0,0,0,4" />
                        <ComboBox ItemsSource="{Binding Source={StaticResource EnemyImageTypeValues}}"
                                  SelectedItem="{Binding Selected.ImageType}" />
                    </StackPanel>
                    <StackPanel Grid.Column="2">
                        <TextBlock Text="이미지 이름" Margin="0,0,0,4" />
                        <TextBox Text="{Binding Selected.Image, UpdateSourceTrigger=PropertyChanged}" />
                    </StackPanel>
                </Grid>
                <TextBlock Text="dragonbones 선택 시 이 이름은 스킬 Motion과 매칭되는 DragonBones 애니메이션 이름으로도 사용됩니다."
                           FontStyle="Italic" Foreground="Gray" TextWrapping="Wrap" Margin="0,0,0,10" />

                <TextBlock Text="메모" Margin="0,0,0,4" />
                <TextBox Text="{Binding Selected.Note, UpdateSourceTrigger=PropertyChanged}"
                         AcceptsReturn="True" TextWrapping="Wrap" Height="60"
                         VerticalScrollBarVisibility="Auto" />
            </StackPanel>
        </ScrollViewer>
    </Grid>
</UserControl>
