<UserControl x:Class="RPGEditor.Views.EnemyEditorView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:views="clr-namespace:RPGEditor.Views"
             mc:Ignorable="d"
             d:DesignHeight="900" d:DesignWidth="1000">
    <Grid Margin="8">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="240" />
            <ColumnDefinition Width="8" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <views:EntryListPanel Grid.Column="0" ShowId="True" />

        <GridSplitter Grid.Column="1" Width="8" HorizontalAlignment="Stretch" Background="Transparent" />

        <ScrollViewer Grid.Column="2" VerticalScrollBarVisibility="Auto"
                      IsEnabled="{Binding Selected, Converter={StaticResource NullToBooleanConverter}}">
            <StackPanel Margin="0,0,10,0">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="16" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Column="0">
                        <TextBlock Text="이름" Margin="0,0,0,4" />
                        <TextBox Text="{Binding Selected.Name, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,0,10" />

                        <Grid Margin="0,0,0,10">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="8" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0">
                                <TextBlock Text="보상 경험치" Margin="0,0,0,4" />
                                <TextBox Text="{Binding Selected.RewardExp, UpdateSourceTrigger=PropertyChanged}" />
                            </StackPanel>
                            <StackPanel Grid.Column="2">
                                <TextBlock Text="보상 골드" Margin="0,0,0,4" />
                                <TextBox Text="{Binding Selected.RewardGold, UpdateSourceTrigger=PropertyChanged}" />
                            </StackPanel>
                        </Grid>

                        <TextBlock Text="스탯" FontWeight="Bold" Margin="0,0,0,6" />
                        <WrapPanel>
                            <StackPanel Margin="0,0,6,6">
                                <TextBlock Text="HP" HorizontalAlignment="Center" />
                                <TextBox Width="54" Text="{Binding Selected.Stats.Hp, UpdateSourceTrigger=PropertyChanged}" />
                            </StackPanel>
                            <StackPanel Margin="0,0,6,6">
                                <TextBlock Text="MP" HorizontalAlignment="Center" />
                                <TextBox Width="54" Text="{Binding Selected.Stats.Mp, UpdateSourceTrigger=PropertyChanged}" />
                            </StackPanel>
                            <StackPanel Margin="0,0,6,6">
                                <TextBlock Text="STR" HorizontalAlignment="Center" />
                                <TextBox Width="54" Text="{Binding Selected.Stats.Str, UpdateSourceTrigger=PropertyChanged}" />
                            </StackPanel>
                            <StackPanel Margin="0,0,6,6">
                                <TextBlock Text="VIT" HorizontalAlignment="Center" />
                                <TextBox Width="54" Text="{Binding Selected.Stats.Vit, UpdateSourceTrigger=PropertyChanged}" />
                            </StackPanel>
                            <StackPanel Margin="0,0,6,6">
                                <TextBlock Text="INT" HorizontalAlignment="Center" />
                                <TextBox Width="54" Text="{Binding Selected.Stats.Int, UpdateSourceTrigger=PropertyChanged}" />
                            </StackPanel>
                            <StackPanel Margin="0,0,6,6">
                                <TextBlock Text="MND" HorizontalAlignment="Center" />
                                <TextBox Width="54" Text="{Binding Selected.Stats.Mnd, UpdateSourceTrigger=PropertyChanged}" />
                            </StackPanel>
                            <StackPanel Margin="0,0,6,6">
                                <TextBlock Text="DEX" HorizontalAlignment="Center" />
                                <TextBox Width="54" Text="{Binding Selected.Stats.Dex, UpdateSourceTrigger=PropertyChanged}" />
                            </StackPanel>
                            <StackPanel Margin="0,0,6,6">
                                <TextBlock Text="AGI" HorizontalAlignment="Center" />
                                <TextBox Width="54" Text="{Binding Selected.Stats.Agi, UpdateSourceTrigger=PropertyChanged}" />
                            </StackPanel>
                            <StackPanel Margin="0,0,6,6">
                                <TextBlock Text="LUK" HorizontalAlignment="Center" />
                                <TextBox Width="54" Text="{Binding Selected.Stats.Luk, UpdateSourceTrigger=PropertyChanged}" />
                            </StackPanel>
                        </WrapPanel>

                        <Grid Margin="0,10,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="8" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0">
                                <TextBlock Text="이미지 유형" Margin="0,0,0,4" />
                                <ComboBox ItemsSource="{Binding Source={StaticResource EnemyImageTypeValues}}"
                                          SelectedItem="{Binding Selected.ImageType}" />
                            </StackPanel>
                            <StackPanel Grid.Column="2">
                                <TextBlock Text="이미지 이름" Margin="0,0,0,4" />
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <TextBox Grid.Column="0" Text="{Binding Selected.Image, UpdateSourceTrigger=PropertyChanged}" />
                                    <Button Grid.Column="1" Content="찾아보기..." Margin="6,0,0,0"
                                            Click="BrowseImageButton_Click" />
                                </Grid>
                            </StackPanel>
                        </Grid>
                        <TextBlock Text="이미지 이름 = DragonBones 아마추어(스켈레톤) 파일 이름입니다."
                                   FontStyle="Italic" Foreground="Gray" TextWrapping="Wrap" Margin="0,4,0,0"
                                   Visibility="{Binding Selected.ImageType, Converter={StaticResource EnumEqualsVisibilityConverter}, ConverterParameter=DragonBones}" />

                        <StackPanel Margin="0,10,0,0"
                                    Visibility="{Binding Selected.ImageType, Converter={StaticResource EnumEqualsVisibilityConverter}, ConverterParameter=DragonBones}">
                            <TextBlock Text="표시 배율(%)" Margin="0,0,0,4" />
                            <TextBox Width="80" HorizontalAlignment="Left"
                                     Text="{Binding Selected.Scale, UpdateSourceTrigger=PropertyChanged}" />
                        </StackPanel>

                        <StackPanel Margin="0,10,0,0"
                                    Visibility="{Binding Selected.ImageType, Converter={StaticResource EnumEqualsVisibilityConverter}, ConverterParameter=DragonBones}">
                            <TextBlock Text="DragonBones 모션 매칭" FontWeight="Bold" Margin="0,0,0,6" />
                            <TextBlock Text="아마추어에 있는 실제 애니메이션 이름을 각 모션에 매칭하세요. (예: wait → Idle)"
                                       FontStyle="Italic" Foreground="Gray" TextWrapping="Wrap" Margin="0,0,0,6" />
                            <ItemsControl ItemsSource="{Binding Selected.MotionMap}">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <WrapPanel />
                                    </ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <StackPanel Orientation="Horizontal" Margin="0,0,10,6">
                                            <TextBlock Text="{Binding Motion}" Width="60" VerticalAlignment="Center" />
                                            <TextBox Text="{Binding AnimationName, UpdateSourceTrigger=PropertyChanged}" Width="100" />
                                        </StackPanel>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                    </StackPanel>

                    <StackPanel Grid.Column="2">
                        <TextBlock Text="드롭 아이템 (Items.json)" FontWeight="Bold" Margin="0,0,0,6" />
                        <DataGrid ItemsSource="{Binding Selected.Drops}"
                                  AutoGenerateColumns="False"
                                  CanUserAddRows="True"
                                  CanUserDeleteRows="True"
                                  CanUserSortColumns="False"
                                  Height="130"
                                  Margin="0,0,0,10">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="아이템 ID" Binding="{Binding ItemId}" Width="100" />
                                <DataGridTextColumn Header="드롭 확률(%)" Binding="{Binding DropRate}" Width="100" />
                            </DataGrid.Columns>
                        </DataGrid>

                        <TextBlock Text="행동 패턴 (Skills.json)" FontWeight="Bold" Margin="0,0,0,6" />
                        <DataGrid ItemsSource="{Binding Selected.Actions}"
                                  AutoGenerateColumns="False"
                                  CanUserAddRows="True"
                                  CanUserDeleteRows="True"
                                  CanUserSortColumns="False"
                                  Height="150"
                                  Margin="0,0,0,10">
                            <DataGrid.Columns>
                                <DataGridComboBoxColumn Header="조건"
                                                         ItemsSource="{Binding Source={StaticResource EnemyActionConditionTypeValues}}"
                                                         SelectedItemBinding="{Binding ConditionType}"
                                                         Width="110" />
                                <DataGridTextColumn Header="값1" Binding="{Binding Param1}" Width="55" />
                                <DataGridTextColumn Header="값2" Binding="{Binding Param2}" Width="55" />
                                <DataGridTextColumn Header="상태 ID" Binding="{Binding StateId}" Width="65" />
                                <DataGridTextColumn Header="우선도" Binding="{Binding Priority}" Width="55" />
                                <DataGridTextColumn Header="스킬 ID" Binding="{Binding SkillId}" Width="65" />
                            </DataGrid.Columns>
                        </DataGrid>
                        <TextBlock Text="값1/값2 의미: 순번=매 N턴/시작오프셋, HP·MP범위=최소%/최대%, 상태조건은 상태 ID만 사용"
                                   FontStyle="Italic" Foreground="Gray" TextWrapping="Wrap" />
                    </StackPanel>
                </Grid>

                <TextBlock Text="메모" Margin="0,10,0,4" />
                <TextBox Text="{Binding Selected.Note, UpdateSourceTrigger=PropertyChanged}"
                         AcceptsReturn="True" TextWrapping="Wrap" Height="60"
                         VerticalScrollBarVisibility="Auto" />
            </StackPanel>
        </ScrollViewer>
    </Grid>
</UserControl>
