<Window x:Class="RPGEditor.Views.ImageFilePickerWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        mc:Ignorable="d"
        Title="이미지 선택" Height="480" Width="640"
        WindowStartupLocation="CenterOwner"
        FontSize="16">
    <Grid Margin="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="180" />
            <ColumnDefinition Width="8" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <ListBox x:Name="ImageListBox" Grid.Row="0" Grid.Column="0"
                 VirtualizingPanel.IsVirtualizing="False"
                 SelectionChanged="ImageListBox_SelectionChanged" />

        <Border Grid.Row="0" Grid.Column="2" BorderBrush="Gray" BorderThickness="1" Background="#1e1e1e">
            <Image x:Name="PreviewImage" Stretch="Uniform" Margin="8" />
        </Border>

        <StackPanel Grid.Row="1" Grid.Column="0" Grid.ColumnSpan="3" Orientation="Horizontal"
                    HorizontalAlignment="Right" Margin="0,10,0,0">
            <Button x:Name="SelectButton" Content="선택" Width="80" IsDefault="True"
                    IsEnabled="False" Click="SelectButton_Click" />
            <Button Content="취소" Width="80" Margin="8,0,0,0" IsCancel="True" />
        </StackPanel>
    </Grid>
</Window>
