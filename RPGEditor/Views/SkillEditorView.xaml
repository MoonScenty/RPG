<UserControl x:Class="RPGEditor.Views.SkillEditorView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:views="clr-namespace:RPGEditor.Views"
             mc:Ignorable="d"
             d:DesignHeight="800" d:DesignWidth="1000">
    <Grid Margin="8">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="240" />
            <ColumnDefinition Width="8" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <views:EntryListPanel Grid.Column="0" ShowId="True" />

        <GridSplitter Grid.Column="1" Width="8" HorizontalAlignment="Stretch" Background="Transparent" />

        <ScrollViewer Grid.Column="2" VerticalScrollBarVisibility="Auto"
                      IsEnabled="{Binding Selected, Converter={StaticResource NullToBooleanConverter}}">
            <StackPanel Margin="0,0,10,0">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="16" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>

                    <!-- 왼쪽: 기본 정보 / 발동 / 메시지 -->
                    <StackPanel Grid.Column="0">
                        <Grid Margin="0,0,0,10">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="8" />
                                <ColumnDefinition Width="130" />
                                <ColumnDefinition Width="8" />
                                <ColumnDefinition Width="90" />
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0">
                                <TextBlock Text="스킬 이름" Margin="0,0,0,4" />
                                <TextBox Text="{Binding Selected.Name, UpdateSourceTrigger=PropertyChanged}" />
                            </StackPanel>
                            <StackPanel Grid.Column="2">
                                <TextBlock Text="아이콘" Margin="0,0,0,4" />
                                <views:IconField x:Name="IconField" IconIndex="{Binding Selected.IconIndex, UpdateSourceTrigger=PropertyChanged}" />
                            </StackPanel>
                            <StackPanel Grid.Column="4">
                                <TextBlock Text="MP 소비" Margin="0,0,0,4" />
                                <TextBox Text="{Binding Selected.MpCost, UpdateSourceTrigger=PropertyChanged}" />
                            </StackPanel>
                        </Grid>

                        <TextBlock Text="설명" Margin="0,0,0,4" />
                        <TextBox Text="{Binding Selected.Description, UpdateSourceTrigger=PropertyChanged}"
                                 AcceptsReturn="True" TextWrapping="Wrap" Height="50"
                                 VerticalScrollBarVisibility="Auto" Margin="0,0,0,10" />

                        <Grid Margin="0,0,0,10">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="8" />
                                <ColumnDefinition Width="140" />
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0">
                                <TextBlock Text="대상 범위" Margin="0,0,0,4" />
                                <ComboBox ItemsSource="{Binding Source={StaticResource SkillScopeValues}}"
                                          SelectedItem="{Binding Selected.Scope}"
                                          ItemTemplate="{StaticResource EnumDisplayItemTemplate}" />
                            </StackPanel>
                            <StackPanel Grid.Column="2">
                                <TextBlock Text="스킬 유형 (Types.json)" Margin="0,0,0,4" />
                                <TextBox Text="{Binding Selected.SkillTypeId, UpdateSourceTrigger=PropertyChanged}" />
                            </StackPanel>
                        </Grid>

                        <Border BorderBrush="Gray" BorderThickness="0,1,0,0" Margin="0,0,0,10" Padding="0,10,0,0">
                            <StackPanel>
                                <TextBlock Text="발동" FontWeight="Bold" Margin="0,0,0,6" />
                                <Grid Margin="0,0,0,6">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="6" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="6" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Grid.Column="0">
                                        <TextBlock Text="속도 보정" Margin="0,0,0,4" />
                                        <TextBox Text="{Binding Selected.Invocation.SpeedCorrection, UpdateSourceTrigger=PropertyChanged}" />
                                    </StackPanel>
                                    <StackPanel Grid.Column="2">
                                        <TextBlock Text="성공률(%)" Margin="0,0,0,4" />
                                        <TextBox Text="{Binding Selected.Invocation.SuccessRate, UpdateSourceTrigger=PropertyChanged}" />
                                    </StackPanel>
                                    <StackPanel Grid.Column="4">
                                        <TextBlock Text="연속 횟수" Margin="0,0,0,4" />
                                        <TextBox Text="{Binding Selected.Invocation.RepeatCount, UpdateSourceTrigger=PropertyChanged}" />
                                    </StackPanel>
                                </Grid>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="8" />
                                        <ColumnDefinition Width="140" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Grid.Column="0">
                                        <TextBlock Text="명중 유형" Margin="0,0,0,4" />
                                        <ComboBox ItemsSource="{Binding Source={StaticResource SkillHitTypeValues}}"
                                                  SelectedItem="{Binding Selected.Invocation.HitType}"
                                                  ItemTemplate="{StaticResource EnumDisplayItemTemplate}" />
                                    </StackPanel>
                                    <StackPanel Grid.Column="2">
                                        <TextBlock Text="애니메이션" Margin="0,0,0,4" />
                                        <views:AnimationField x:Name="SkillAnimationField"
                                                               AnimationId="{Binding Selected.Invocation.AnimationId, UpdateSourceTrigger=PropertyChanged}" />
                                    </StackPanel>
                                </Grid>
                            </StackPanel>
                        </Border>

                        <TextBlock Text="메시지 (%1=자신, %2=스킬명, %3=대상)" Margin="0,0,0,4" />
                        <TextBox Text="{Binding Selected.Message, UpdateSourceTrigger=PropertyChanged}" />
                    </StackPanel>

                    <!-- 오른쪽: 피해 / 사용 효과 / 기타 -->
                    <StackPanel Grid.Column="2">
                        <Border BorderBrush="Gray" BorderThickness="0,0,0,0" Margin="0,0,0,10" Padding="0,0,0,0">
                            <StackPanel>
                                <TextBlock Text="피해" FontWeight="Bold" Margin="0,0,0,6" />
                                <Grid Margin="0,0,0,6">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="8" />
                                        <ColumnDefinition Width="140" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Grid.Column="0">
                                        <TextBlock Text="유형" Margin="0,0,0,4" />
                                        <ComboBox ItemsSource="{Binding Source={StaticResource DamageTypeValues}}"
                                                  SelectedItem="{Binding Selected.Damage.Type}"
                                                  ItemTemplate="{StaticResource EnumDisplayItemTemplate}" />
                                    </StackPanel>
                                    <StackPanel Grid.Column="2">
                                        <TextBlock Text="속성 ID (Types.json)" Margin="0,0,0,4" />
                                        <TextBox Text="{Binding Selected.Damage.ElementId, UpdateSourceTrigger=PropertyChanged}" />
                                    </StackPanel>
                                </Grid>
                                <TextBlock Text="계산식 (예: a.atk * 4 - b.def * 2)" Margin="0,0,0,4" />
                                <TextBox Text="{Binding Selected.Damage.Formula, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,0,6" />
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="8" />
                                        <ColumnDefinition Width="140" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Grid.Column="0">
                                        <TextBlock Text="분산도(%)" Margin="0,0,0,4" />
                                        <TextBox Text="{Binding Selected.Damage.Variance, UpdateSourceTrigger=PropertyChanged}" />
                                    </StackPanel>
                                    <StackPanel Grid.Column="2" VerticalAlignment="Bottom">
                                        <CheckBox Content="치명타 가능" IsChecked="{Binding Selected.Damage.CriticalEnabled}" />
                                    </StackPanel>
                                </Grid>
                            </StackPanel>
                        </Border>

                        <TextBlock Text="사용 효과" FontWeight="Bold" Margin="0,0,0,6" />
                        <DataGrid x:Name="EffectsDataGrid" ItemsSource="{Binding Selected.Effects}"
                                  AutoGenerateColumns="False"
                                  CanUserAddRows="True"
                                  CanUserDeleteRows="True"
                                  CanUserSortColumns="False"
                                  Height="150"
                                  Margin="0,0,0,10">
                            <DataGrid.Columns>
                                <DataGridTemplateColumn Header="종류" Width="150">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <TextBlock Text="{Binding Kind, Converter={StaticResource EnumDisplayConverter}}"
                                                       VerticalAlignment="Center" Margin="4,0" />
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                    <DataGridTemplateColumn.CellEditingTemplate>
                                        <DataTemplate>
                                            <ComboBox ItemsSource="{Binding Source={StaticResource SkillEffectKindValues}}"
                                                      SelectedItem="{Binding Kind, Mode=TwoWay}"
                                                      ItemTemplate="{StaticResource EnumDisplayItemTemplate}" />
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellEditingTemplate>
                                </DataGridTemplateColumn>
                                <DataGridTextColumn Header="퍼센트(%)" Binding="{Binding PercentValue}" Width="80" />
                                <DataGridTextColumn Header="고정값" Binding="{Binding FlatValue}" Width="80" />
                                <DataGridTemplateColumn Header="상태 ID" Width="160">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <TextBlock VerticalAlignment="Center" Margin="4,0">
                                                <TextBlock.Text>
                                                    <MultiBinding Converter="{StaticResource StateIdToNameConverter}">
                                                        <Binding Path="StateId" />
                                                        <Binding Path="Tag" RelativeSource="{RelativeSource AncestorType=DataGrid}" />
                                                    </MultiBinding>
                                                </TextBlock.Text>
                                            </TextBlock>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                    <DataGridTemplateColumn.CellEditingTemplate>
                                        <DataTemplate>
                                            <ComboBox ItemsSource="{Binding Tag, RelativeSource={RelativeSource AncestorType=DataGrid}}"
                                                      SelectedValuePath="Id"
                                                      SelectedValue="{Binding StateId, Mode=TwoWay}">
                                                <ComboBox.ItemTemplate>
                                                    <DataTemplate>
                                                        <StackPanel Orientation="Horizontal">
                                                            <TextBlock Text="{Binding Id}" />
                                                            <TextBlock Text=": " />
                                                            <TextBlock Text="{Binding Name}" />
                                                        </StackPanel>
                                                    </DataTemplate>
                                                </ComboBox.ItemTemplate>
                                            </ComboBox>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellEditingTemplate>
                                </DataGridTemplateColumn>
                                <DataGridTextColumn Header="확률(%)" Binding="{Binding Chance}" Width="70" />
                            </DataGrid.Columns>
                        </DataGrid>

                        <Grid Margin="0,0,0,10">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="8" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0">
                                <TextBlock Text="사용 가능 위치" Margin="0,0,0,4" />
                                <ComboBox ItemsSource="{Binding Source={StaticResource SkillUsablePositionValues}}"
                                          SelectedItem="{Binding Selected.UsablePosition}"
                                          ItemTemplate="{StaticResource EnumDisplayItemTemplate}" />
                            </StackPanel>
                            <StackPanel Grid.Column="2">
                                <TextBlock Text="SV 배틀러 모션" Margin="0,0,0,4" />
                                <ComboBox IsEditable="True"
                                          ItemsSource="{Binding Source={StaticResource SvMotionValues}}"
                                          Text="{Binding Selected.Motion, UpdateSourceTrigger=PropertyChanged}" />
                            </StackPanel>
                        </Grid>

                        <Grid Margin="0,0,0,10">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="8" />
                                <ColumnDefinition Width="160" />
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0">
                                <TextBlock Text="요구 상태 ID (States.json, 0=없음)" Margin="0,0,0,4" />
                                <TextBox Text="{Binding Selected.RequiredStateId, UpdateSourceTrigger=PropertyChanged}" />
                            </StackPanel>
                            <StackPanel Grid.Column="2" VerticalAlignment="Bottom">
                                <CheckBox Content="사용 시 요구 상태 해제" IsChecked="{Binding Selected.RemoveRequiredStateOnUse}" />
                            </StackPanel>
                        </Grid>

                        <TextBlock Text="마법진 이미지 (img/magic_circles, 비우면 없음)" Margin="0,0,0,4" />
                        <TextBox Text="{Binding Selected.MagicCircleImage, UpdateSourceTrigger=PropertyChanged}" />
                    </StackPanel>
                </Grid>

                <TextBlock Text="메모" Margin="0,10,0,4" />
                <TextBox Text="{Binding Selected.Note, UpdateSourceTrigger=PropertyChanged}"
                         AcceptsReturn="True" TextWrapping="Wrap" Height="60"
                         VerticalScrollBarVisibility="Auto" />
            </StackPanel>
        </ScrollViewer>
    </Grid>
</UserControl>
