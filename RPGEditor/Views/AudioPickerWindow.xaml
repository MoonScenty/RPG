<Window x:Class="RPGEditor.Views.AudioPickerWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:views="clr-namespace:RPGEditor.Views"
        mc:Ignorable="d"
        Title="음악 선택" Height="480" Width="380"
        WindowStartupLocation="CenterOwner"
        FontSize="16">
    <Grid Margin="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <ListBox x:Name="AudioListBox" Grid.Row="0"
                 VirtualizingPanel.IsVirtualizing="False"
                 SelectionChanged="AudioListBox_SelectionChanged" />

        <!-- 실제로는 보이지 않는 오디오 재생용 WebView2. WPF 에어스페이스 제약으로 다른 컨트롤과 겹치면 안 됨 -->
        <views:AudioPreviewControl x:Name="Preview" Grid.Row="1" Height="1" Margin="0,4,0,0" />

        <Grid Grid.Row="2" Margin="0,4,0,0" Height="30">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <TextBlock x:Name="StatusText" Grid.Column="0" VerticalAlignment="Center" Foreground="Gray" />
            <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center" Margin="6,0,0,0">
                <Button Content="▶ 재생" Width="90" Click="PlayButton_Click" />
                <Button Content="■ 정지" Width="90" Margin="6,0,0,0" Click="StopButton_Click" />
            </StackPanel>
        </Grid>

        <StackPanel Grid.Row="3" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,10,0,0">
            <Button Content="없음으로 설정" Width="130" Click="ClearButton_Click" />
            <Button x:Name="SelectButton" Content="선택" Width="80" Margin="8,0,0,0" IsDefault="True"
                    IsEnabled="False" Click="SelectButton_Click" />
            <Button Content="취소" Width="80" Margin="8,0,0,0" IsCancel="True" />
        </StackPanel>
    </Grid>
</Window>
