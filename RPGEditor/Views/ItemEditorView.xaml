<UserControl x:Class="RPGEditor.Views.ItemEditorView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:views="clr-namespace:RPGEditor.Views"
             mc:Ignorable="d"
             d:DesignHeight="900" d:DesignWidth="1000">
    <Grid Margin="8">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="240" />
            <ColumnDefinition Width="8" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <views:EntryListPanel Grid.Column="0" ShowId="True" />

        <GridSplitter Grid.Column="1" Width="8" HorizontalAlignment="Stretch" Background="Transparent" />

        <ScrollViewer Grid.Column="2" VerticalScrollBarVisibility="Auto"
                      IsEnabled="{Binding Selected, Converter={StaticResource NullToBooleanConverter}}">
            <StackPanel Margin="0,0,10,0">
                <Grid Margin="0,0,0,6">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="8" />
                        <ColumnDefinition Width="130" />
                        <ColumnDefinition Width="8" />
                        <ColumnDefinition Width="90" />
                        <ColumnDefinition Width="16" />
                        <ColumnDefinition Width="200" />
                    </Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="0">
                        <TextBlock Text="이름" Margin="0,0,0,4" />
                        <TextBox Text="{Binding Selected.Name, UpdateSourceTrigger=PropertyChanged}" />
                    </StackPanel>
                    <StackPanel Grid.Column="2">
                        <TextBlock Text="아이콘" Margin="0,0,0,4" />
                        <views:IconField x:Name="IconField" IconIndex="{Binding Selected.IconIndex, UpdateSourceTrigger=PropertyChanged}" />
                    </StackPanel>
                    <StackPanel Grid.Column="4">
                        <TextBlock Text="가격" Margin="0,0,0,4" />
                        <TextBox Text="{Binding Selected.Price, UpdateSourceTrigger=PropertyChanged}" />
                    </StackPanel>
                    <StackPanel Grid.Column="6">
                        <TextBlock Text="유형" Margin="0,0,0,4" />
                        <ComboBox ItemsSource="{Binding Source={StaticResource ItemKindValues}}"
                                  SelectedItem="{Binding Selected.Kind}"
                                  ItemTemplate="{StaticResource EnumDisplayItemTemplate}" />
                    </StackPanel>
                </Grid>

                <TextBlock Text="설명" Margin="0,0,0,4" />
                <TextBox Text="{Binding Selected.Description, UpdateSourceTrigger=PropertyChanged}"
                         AcceptsReturn="True" TextWrapping="Wrap" Height="50"
                         VerticalScrollBarVisibility="Auto" Margin="0,0,0,10" />

                <!-- 재료: 추가 속성 없음 -->
                <TextBlock Text="재료 항목은 추가 속성이 없습니다."
                           FontStyle="Italic" Margin="0,0,0,10"
                           Visibility="{Binding Selected.Kind, Converter={StaticResource EnumEqualsVisibilityConverter}, ConverterParameter=Material}" />

                <!-- 소모품 -->
                <Grid Visibility="{Binding Selected.Kind, Converter={StaticResource EnumEqualsVisibilityConverter}, ConverterParameter=Consumable}">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="16" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Column="0">
                        <TextBlock Text="대상 범위" Margin="0,0,0,4" />
                        <ComboBox ItemsSource="{Binding Source={StaticResource ItemScopeValues}}"
                                  SelectedItem="{Binding Selected.Consumable.Scope}"
                                  ItemTemplate="{StaticResource EnumDisplayItemTemplate}" Margin="0,0,0,10" />

                        <Border BorderBrush="Gray" BorderThickness="0,1,0,0" Margin="0,0,0,10" Padding="0,10,0,0">
                            <StackPanel>
                                <TextBlock Text="발동" FontWeight="Bold" Margin="0,0,0,6" />
                                <Grid Margin="0,0,0,6">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="6" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="6" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="6" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Grid.Column="0">
                                        <TextBlock Text="속도 보정" Margin="0,0,0,4" />
                                        <TextBox Text="{Binding Selected.Consumable.Invocation.SpeedCorrection, UpdateSourceTrigger=PropertyChanged}" />
                                    </StackPanel>
                                    <StackPanel Grid.Column="2">
                                        <TextBlock Text="성공률(%)" Margin="0,0,0,4" />
                                        <TextBox Text="{Binding Selected.Consumable.Invocation.SuccessRate, UpdateSourceTrigger=PropertyChanged}" />
                                    </StackPanel>
                                    <StackPanel Grid.Column="4">
                                        <TextBlock Text="연속 횟수" Margin="0,0,0,4" />
                                        <TextBox Text="{Binding Selected.Consumable.Invocation.RepeatCount, UpdateSourceTrigger=PropertyChanged}" />
                                    </StackPanel>
                                    <StackPanel Grid.Column="6">
                                        <TextBlock Text="TP 획득량" Margin="0,0,0,4" />
                                        <TextBox Text="{Binding Selected.Consumable.Invocation.TpGain, UpdateSourceTrigger=PropertyChanged}" />
                                    </StackPanel>
                                </Grid>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="8" />
                                        <ColumnDefinition Width="140" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Grid.Column="0">
                                        <TextBlock Text="명중 유형" Margin="0,0,0,4" />
                                        <ComboBox ItemsSource="{Binding Source={StaticResource SkillHitTypeValues}}"
                                                  SelectedItem="{Binding Selected.Consumable.Invocation.HitType}"
                                                  ItemTemplate="{StaticResource EnumDisplayItemTemplate}" />
                                    </StackPanel>
                                    <StackPanel Grid.Column="2">
                                        <TextBlock Text="애니메이션 ID" Margin="0,0,0,4" />
                                        <TextBox Text="{Binding Selected.Consumable.Invocation.AnimationId, UpdateSourceTrigger=PropertyChanged}" />
                                    </StackPanel>
                                </Grid>
                            </StackPanel>
                        </Border>

                        <Border BorderBrush="Gray" BorderThickness="0,1,0,0" Padding="0,10,0,0">
                            <StackPanel>
                                <TextBlock Text="피해" FontWeight="Bold" Margin="0,0,0,6" />
                                <Grid Margin="0,0,0,6">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="8" />
                                        <ColumnDefinition Width="140" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Grid.Column="0">
                                        <TextBlock Text="유형" Margin="0,0,0,4" />
                                        <ComboBox ItemsSource="{Binding Source={StaticResource DamageTypeValues}}"
                                                  SelectedItem="{Binding Selected.Consumable.Damage.Type}"
                                                  ItemTemplate="{StaticResource EnumDisplayItemTemplate}" />
                                    </StackPanel>
                                    <StackPanel Grid.Column="2">
                                        <TextBlock Text="속성 (Types.json)" Margin="0,0,0,4" />
                                        <ComboBox ItemsSource="{Binding Types.Elements, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                  SelectedIndex="{Binding Selected.Consumable.Damage.ElementId, UpdateSourceTrigger=PropertyChanged}" />
                                    </StackPanel>
                                </Grid>
                                <TextBlock Text="계산식 (예: a.atk * 4 - b.def * 2)" Margin="0,0,0,4" />
                                <TextBox Text="{Binding Selected.Consumable.Damage.Formula, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,0,6" />
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="8" />
                                        <ColumnDefinition Width="140" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Grid.Column="0">
                                        <TextBlock Text="분산도(%)" Margin="0,0,0,4" />
                                        <TextBox Text="{Binding Selected.Consumable.Damage.Variance, UpdateSourceTrigger=PropertyChanged}" />
                                    </StackPanel>
                                    <StackPanel Grid.Column="2" VerticalAlignment="Bottom">
                                        <CheckBox Content="치명타 가능" IsChecked="{Binding Selected.Consumable.Damage.CriticalEnabled}" />
                                    </StackPanel>
                                </Grid>
                            </StackPanel>
                        </Border>
                    </StackPanel>

                    <StackPanel Grid.Column="2">
                        <TextBlock Text="사용 효과" FontWeight="Bold" Margin="0,0,0,6" />
                        <DataGrid ItemsSource="{Binding Selected.Consumable.Effects}"
                                  AutoGenerateColumns="False"
                                  CanUserAddRows="True"
                                  CanUserDeleteRows="True"
                                  CanUserSortColumns="False"
                                  Height="150"
                                  Margin="0,0,0,10">
                            <DataGrid.Columns>
                                <DataGridTemplateColumn Header="종류" Width="150">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <TextBlock Text="{Binding Kind, Converter={StaticResource EnumDisplayConverter}}"
                                                       VerticalAlignment="Center" Margin="4,0" />
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                    <DataGridTemplateColumn.CellEditingTemplate>
                                        <DataTemplate>
                                            <ComboBox ItemsSource="{Binding Source={StaticResource SkillEffectKindValues}}"
                                                      SelectedItem="{Binding Kind, Mode=TwoWay}"
                                                      ItemTemplate="{StaticResource EnumDisplayItemTemplate}" />
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellEditingTemplate>
                                </DataGridTemplateColumn>
                                <DataGridTextColumn Header="퍼센트(%)" Binding="{Binding PercentValue}" Width="80" />
                                <DataGridTextColumn Header="고정값" Binding="{Binding FlatValue}" Width="80" />
                                <DataGridTextColumn Header="상태 ID" Binding="{Binding StateId}" Width="70" />
                                <DataGridTextColumn Header="확률(%)" Binding="{Binding Chance}" Width="70" />
                            </DataGrid.Columns>
                        </DataGrid>

                        <Border BorderBrush="Gray" BorderThickness="0,1,0,0" Padding="0,10,0,0">
                            <views:CraftingEditor DataContext="{Binding Selected.Consumable}" />
                        </Border>
                    </StackPanel>
                </Grid>

                <!-- 무기 -->
                <StackPanel Visibility="{Binding Selected.Kind, Converter={StaticResource EnumEqualsVisibilityConverter}, ConverterParameter=Weapon}"
                            Margin="0,0,0,10">
                    <Grid Margin="0,0,0,10">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="16" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0">
                            <TextBlock Text="무기 유형 (Types.json)" Margin="0,0,0,4" />
                            <ComboBox ItemsSource="{Binding Types.WeaponTypes, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                      SelectedIndex="{Binding Selected.Weapon.WeaponTypeId, UpdateSourceTrigger=PropertyChanged}" />
                        </StackPanel>
                        <StackPanel Grid.Column="2">
                            <TextBlock Text="공격 애니메이션" Margin="0,0,0,4" />
                            <views:AnimationField x:Name="WeaponAnimationField"
                                                   AnimationId="{Binding Selected.Weapon.AnimationId, UpdateSourceTrigger=PropertyChanged}" />
                        </StackPanel>
                    </Grid>
                    <views:EquipParamsEditor DataContext="{Binding Selected.Weapon.Params}" Margin="0,0,0,10" />
                    <Border BorderBrush="Gray" BorderThickness="0,1,0,0" Padding="0,10,0,0">
                        <views:CraftingEditor DataContext="{Binding Selected.Weapon}" />
                    </Border>
                </StackPanel>

                <!-- 방어구 -->
                <StackPanel Visibility="{Binding Selected.Kind, Converter={StaticResource EnumEqualsVisibilityConverter}, ConverterParameter=Armor}"
                            Margin="0,0,0,10">
                    <Grid Margin="0,0,0,10">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="16" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0">
                            <TextBlock Text="방어구 유형 (Types.json)" Margin="0,0,0,4" />
                            <ComboBox ItemsSource="{Binding Types.ArmorTypes, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                      SelectedIndex="{Binding Selected.Armor.ArmorTypeId, UpdateSourceTrigger=PropertyChanged}" />
                        </StackPanel>
                        <StackPanel Grid.Column="2">
                            <TextBlock Text="장비 유형/부위 (Types.json)" Margin="0,0,0,4" />
                            <ComboBox ItemsSource="{Binding Types.EquipTypes, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                      SelectedIndex="{Binding Selected.Armor.EquipTypeId, UpdateSourceTrigger=PropertyChanged}" />
                        </StackPanel>
                    </Grid>
                    <views:EquipParamsEditor DataContext="{Binding Selected.Armor.Params}" Margin="0,0,0,10" />
                    <Border BorderBrush="Gray" BorderThickness="0,1,0,0" Padding="0,10,0,0">
                        <views:CraftingEditor DataContext="{Binding Selected.Armor}" />
                    </Border>
                </StackPanel>

                <TextBlock Text="메모" Margin="0,10,0,4" />
                <TextBox Text="{Binding Selected.Note, UpdateSourceTrigger=PropertyChanged}"
                         AcceptsReturn="True" TextWrapping="Wrap" Height="60"
                         VerticalScrollBarVisibility="Auto" />
            </StackPanel>
        </ScrollViewer>
    </Grid>
</UserControl>
