<UserControl x:Class="RPGEditor.Views.TypeCategoryColumn"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             mc:Ignorable="d"
             d:DesignHeight="600" d:DesignWidth="190">
    <DockPanel>
        <TextBlock DockPanel.Dock="Top" Text="{Binding CategoryName}" FontWeight="Bold" Margin="0,0,0,6" />

        <Button DockPanel.Dock="Bottom" Content="최대치 변경..." Margin="0,6,0,0"
                Command="{Binding ChangeMaxCommand}"
                CommandParameter="{Binding RelativeSource={RelativeSource AncestorType=Window}}" />

        <TextBox DockPanel.Dock="Bottom"
                 Text="{Binding SelectedText, UpdateSourceTrigger=PropertyChanged}"
                 Margin="0,6,0,0" />

        <ListBox ItemsSource="{Binding Items}"
                 SelectedIndex="{Binding SelectedIndex}"
                 AlternationCount="99999">
            <ListBox.ItemTemplate>
                <DataTemplate>
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Width="26" Foreground="Gray"
                                   Text="{Binding RelativeSource={RelativeSource AncestorType=ListBoxItem}, Path=(ItemsControl.AlternationIndex), Converter={StaticResource IndexToDisplayConverter}}" />
                        <TextBlock Text="{Binding}" />
                    </StackPanel>
                </DataTemplate>
            </ListBox.ItemTemplate>
        </ListBox>
    </DockPanel>
</UserControl>
