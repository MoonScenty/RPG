  <ItemGroup>
    <None Include="Assets\AnimationPreview\**" CopyToOutputDirectory="PreserveNewest" />
    <None Include="Assets\DragonBonesPreview\**" CopyToOutputDirectory="PreserveNewest" />
    <None Include="Assets\AudioPreview\**" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

</Project>
