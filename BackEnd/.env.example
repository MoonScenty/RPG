APP_NAME=RPG
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost

APP_LOCALE=ko
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file

LOG_CHANNEL=stack
LOG_STACK=single
LOG_LEVEL=debug

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=rpg
DB_USERNAME=root
DB_PASSWORD=

SESSION_DRIVER=database
# 0으로 두면 안 됨 - config/session.php 주석 참고 (Sanctum CSRF 쿠키가
# 즉시 만료돼버려 로그인이 419로 막힘). 브라우저 종료 시 세션 삭제는
# expire_on_close(config/session.php, 항상 true)가 별도로 담당한다.
SESSION_LIFETIME=120
SESSION_SECURE_COOKIE=true
SESSION_SAME_SITE=none

CACHE_STORE=database
QUEUE_CONNECTION=database

MAIL_MAILER=log
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

# FrontEnd/ SPA가 서빙되는 origin들 (콤마로 구분), 예: https://rpg.moonscenty.me
SANCTUM_STATEFUL_DOMAINS=
CORS_ALLOWED_ORIGINS=
